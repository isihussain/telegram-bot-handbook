# Copy to .env and fill in. Never commit .env.
# Get a token from @BotFather. Treat it like a password.
BOT_TOKEN=
# Webhook mode only
WEBHOOK_URL=https://bot.example.com/telegram
WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
# Comma separated numeric Telegram user ids allowed to run admin commands
ADMIN_IDS=
